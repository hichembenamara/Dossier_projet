# Dépendances
node_modules/
**/node_modules/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.pyc

# Build / cache
.next/
**/.next/
dist/
build/
.cache/
*.tsbuildinfo

# Données et médias lourds (à servir via Docker volume / CDN)
data/
exports/
*.csv
*.sql

# Fichiers temporaires
*.tmp
*.tmp.*
*.log
.DS_Store
Thumbs.db

# Environnement
.env
.env.local
**/.env
**/.env.local
!.env.example
!**/.env.example

# IDE
.vscode/
.idea/
*.swp

# PDF / images de référence du sujet
*.pdf
sa-dashboard*.png

# Sauvegardes générées (dumps BDD) — garder le dossier, pas son contenu
backups/*
!backups/.gitkeep

# Scripts de schéma versionnés (le référentiel CDA exige le script de création)
!backend/db/*.sql
# Sidecars de visual-check archify (preuves régénérables)
dossier/figures/archify/*.visual-check.*
# Notes d'architecture archivées : voir docs/archive/

# Playwright (rapports et traces E2E)
frontend/playwright-report/
frontend/test-results/
